---
// 极简 Footer：只显示备案号（来源 src/content/admin/site.yml，后台「站点设置」可改）。
// 没填就整块不渲染，不占位、不影响布局。
import { loadSiteConfig } from "../../../utils/load-admin-config";

const site = loadSiteConfig();
const icp = (site.icp || "").trim();
const icpLink = (site.icpLink || "").trim() || "https://beian.miit.gov.cn/";
---

{
	icp && (
		<footer class="blog-footer text-50">
			<div class="footer-inner">
				<a href={icpLink} target="_blank" rel="noopener noreferrer">
					{icp}
				</a>
			</div>
		</footer>
	)
}

<style>
	.blog-footer {
		padding: 20px 12px 28px;
		text-align: center;
		/* 用 px 不用 rem：主题把根字号缩到了 13.6px，0.75rem 会变成 10.2px，太小 */
		font-size: 12px;
		line-height: 1.9;
		letter-spacing: 0.01em;
	}

	.footer-inner :global(a) {
		color: inherit;
		text-decoration: none;
		transition: color 150ms ease;
	}

	.footer-inner :global(a:hover) {
		color: oklch(0.62 0.14 var(--hue, 240));
		text-decoration: underline;
		text-underline-offset: 3px;
	}
</style>
