---
import fs from "node:fs";
import path from "node:path";

import { Icon } from "astro-icon/components";

import { siteConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "../../../utils/content-utils";
import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		let text = post.body;

		// 移除代码块
		text = text.replace(/```[\s\S]*?```/g, "");
		// 移除 ` 包裹的行内代码
		text = text.replace(/`[^`]+`/g, "");

		// 使用与 remark-content.mjs 完全一致的 CJK 正则
		const cjkPattern =
			/[\u4e00-\u9fa5\u3040-\u309f\u30a0-\u30ff\uac00-\ud7af\u3000-\u303f\uff00-\uffef]/g;

		const cjkMatches = text.match(cjkPattern);
		const cjkCount = cjkMatches ? cjkMatches.length : 0;

		// 计算非 CJK 单词数
		const nonCjkText = text.replace(cjkPattern, " ");

		// 按空白字符分割，计算单词数量
		const nonCjkWords = nonCjkText
			.split(/\s+/)
			.filter((word) => word.trim().length > 0);

		totalWords += cjkCount + nonCjkWords.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 「最后活动」= 最近一次内容改动，不能只看文章发布日期：
// 改相册、日记、友链、时间线这些都不写文章，但确实是站点更新。
// 这里取内容目录里最新的文件修改时间。
// 组件在多个页面渲染，用模块级缓存避免重复扫描。
let cachedLastActivity: string | null | undefined;

function scanLatestMtime(dir: string, skip: (name: string) => boolean): number {
	let max = 0;
	let entries: fs.Dirent[];
	try {
		entries = fs.readdirSync(dir, { withFileTypes: true });
	} catch {
		return 0; // 目录不存在就跳过
	}
	for (const entry of entries) {
		if (skip(entry.name)) continue;
		const abs = path.join(dir, entry.name);
		if (entry.isDirectory()) {
			max = Math.max(max, scanLatestMtime(abs, skip));
		} else {
			try {
				max = Math.max(max, fs.statSync(abs).mtimeMs);
			} catch {
				/* 单个文件读不到不影响整体 */
			}
		}
	}
	return max;
}

function getLastActivity(): string | null {
	if (cachedLastActivity !== undefined) return cachedLastActivity;
	const root = process.cwd();
	// 系统产出的缩略图（.thumb.webp / -m.webp）不算用户活动，否则每次构建都刷新
	const skip = (name: string) =>
		name.startsWith(".") || /(\.thumb|-m)\.webp$/i.test(name);

	const latest = Math.max(
		scanLatestMtime(path.join(root, "src/content"), skip), // 文章 + 各板块 yml
		scanLatestMtime(path.join(root, "public/images/albums"), skip), // 相册照片与 info.json
	);

	cachedLastActivity = latest > 0 ? new Date(latest).toISOString() : null;
	return cachedLastActivity;
}

const lastActivityDate = getLastActivity();

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length,
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length,
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length,
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		value: totalWords,
		formatted: true,
	},
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDays).replace("{days}", ""),
		dynamic: true,
		id: "running-days",
	},
	{
		icon: "material-symbols:ecg-heart-outline",
		label: i18n(I18nKey.siteStatsLastUpdate),
		value: 0, // 将由客户端更新
		suffix: i18n(I18nKey.siteStatsDaysAgo).replace("{days}", ""),
		dynamic: true,
		id: "last-update",
	},
];
---

<WidgetLayout
	name={i18n(I18nKey.siteStats)}
	id="site-stats"
	class={className}
	style={style}
>
	<div class="flex flex-col gap-1">
		{
			stats.map((stat) => (
				<div class="flex items-center justify-between px-2 py-2">
					<div class="flex items-center gap-2.5 flex-1 min-w-0">
						<div class="text-[var(--primary)] text-xl shrink-0">
							<Icon name={stat.icon} />
						</div>
						<span class="text-neutral-700 dark:text-neutral-300 font-medium text-sm break-words leading-tight">
							{stat.label}
						</span>
					</div>
					<div class="flex items-center ml-3 shrink-0">
						<span
							class="text-base font-bold text-neutral-900 dark:text-neutral-100"
							data-stat-id={stat.id}
						>
							{stat.formatted
								? formatNumber(stat.value)
								: stat.value}
						</span>
						{stat.suffix && (
							<span
								class="text-sm text-neutral-500 dark:text-neutral-400 ml-1"
								data-stat-suffix={stat.id}
							>
								{stat.suffix}
							</span>
						)}
					</div>
				</div>
			))
		}
	</div>
</WidgetLayout>

<script is:inline define:vars={{ siteStartDate, lastActivityDate }}>
	function updateDynamicStats() {
		const today = new Date();

		// 更新运行天数
		const startDate = new Date(siteStartDate);
		const diffTime = Math.abs(today.getTime() - startDate.getTime());
		const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

		const runningDaysElements = document.querySelectorAll(
			'[data-stat-id="running-days"]',
		);
		if (runningDaysElements.length > 0) {
			runningDaysElements.forEach((element) => {
				element.textContent = diffDays.toString();
			});
		}

		// 更新最后活动时间（取内容文件的最新修改时间）
		if (lastActivityDate) {
			const lastActive = new Date(lastActivityDate);
			const timeSinceLast = Math.abs(
				today.getTime() - lastActive.getTime(),
			);
			const daysSinceUpdate = Math.floor(
				timeSinceLast / (1000 * 60 * 60 * 24),
			);

			const lastUpdateElements = document.querySelectorAll(
				'[data-stat-id="last-update"]',
			);
			lastUpdateElements.forEach((element) => {
				// 当天改的就显示「今天」，比「0 天前」自然
				const isToday = daysSinceUpdate === 0;
				element.textContent = isToday
					? "今天"
					: daysSinceUpdate.toString();
				const suffix = element.parentElement?.querySelector(
					'[data-stat-suffix="last-update"]',
				);
				if (suffix) {
					suffix.style.display = isToday ? "none" : "";
				}
			});
		}
	}

	// 页面加载时更新
	updateDynamicStats();

	// 每小时更新一次（可选，因为天数变化较慢）
	setInterval(updateDynamicStats, 60 * 60 * 1000);
</script>
