---
import { PhotoCard } from "@components/features/albums";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import { siteConfig } from "../../../config";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import type { AlbumGroup, Photo } from "../../../types/album";
import { scanAlbums } from "../../../utils/album-scanner";

if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

export const getStaticPaths = async () => {
	const albumsData = await scanAlbums();
	return albumsData.map((album) => ({
		params: { id: album.id },
		props: { album },
	}));
};

interface Props {
	album: AlbumGroup;
}

const { album } = Astro.props;

if (!album) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={album.title} description={album.description || album.title}>
	<script>
		import("../../../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../../../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<!-- Cover Banner -->
	<div class="w-full rounded-(--radius-large) overflow-hidden relative">
		{album.cover ? (
			<div class="relative w-full aspect-[3/1] min-h-[200px] max-h-[360px]">
				<img
					src={album.cover}
					alt={album.title}
					class="w-full h-full object-cover"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />

				<!-- Back button -->
				<a
					href="/albums/"
					class="absolute top-4 left-4 inline-flex items-center gap-1.5 text-sm text-white/90 hover:text-white bg-black/30 hover:bg-black/50 backdrop-blur-sm px-3 py-1.5 rounded-lg transition-colors"
				>
					<Icon name="material-symbols:arrow-back" class="text-base" />
					{i18n(I18nKey.albumsBackToList)}
				</a>

				<!-- Album info overlay -->
				<div class="absolute bottom-0 left-0 right-0 p-6">
					<div class="text-2xl sm:text-3xl font-bold text-white mb-2 drop-shadow-lg">
						{album.title}
					</div>
					{album.description && (
						<p class="text-sm text-white/75 leading-relaxed mb-2 max-w-2xl line-clamp-2">
							{album.description}
						</p>
					)}
					<div class="flex items-center gap-4 text-sm text-white/80 flex-wrap">
						<span class="inline-flex items-center gap-1">
							<Icon name="material-symbols:calendar-today" class="text-sm" />
							{new Date(album.date).toLocaleDateString("zh-CN")}
						</span>
						{album.location && (
							<span class="inline-flex items-center gap-1">
								<Icon name="material-symbols:location-on" class="text-sm" />
								{album.location}
							</span>
						)}
						<span class="inline-flex items-center gap-1">
							<Icon name="material-symbols:photo-library" class="text-sm" />
							{album.photos.length} {i18n(I18nKey.albumsPhotosCount)}
						</span>
					</div>
					{album.tags && album.tags.length > 0 && (
						<div class="flex flex-wrap gap-1.5 mt-2.5">
							{album.tags.map((tag: string) => (
								<span class="text-xs px-2 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
									{tag}
								</span>
							))}
						</div>
					)}
				</div>
			</div>
		) : (
			<div class="card-base px-6 py-4">
				<a
					href="/albums/"
					class="inline-flex items-center gap-1 text-sm text-(--primary) hover:underline mb-3"
				>
					<Icon name="material-symbols:arrow-back" class="text-base" />
					{i18n(I18nKey.albumsBackToList)}
				</a>
				<div class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
					{album.title}
				</div>
				<div class="flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400 mt-2 flex-wrap">
					<span class="inline-flex items-center gap-1">
						<Icon name="material-symbols:calendar-today" class="text-sm" />
						{new Date(album.date).toLocaleDateString("zh-CN")}
					</span>
					{album.location && (
						<span class="inline-flex items-center gap-1">
							<Icon name="material-symbols:location-on" class="text-sm" />
							{album.location}
						</span>
					)}
					<span>{album.photos.length} {i18n(I18nKey.albumsPhotosCount)}</span>
				</div>
			</div>
		)}
	</div>

	<!-- Photo Masonry Grid -->
	<div class="w-full rounded-(--radius-large) overflow-hidden relative mt-4">
		<div class="card-base z-10 px-6 py-6 relative w-full">
			{album.photos.length > 0 ? (
				<div class="gallery-masonry">
					{album.photos.map((photo: Photo) => (
						<PhotoCard
							src={photo.src}
							thumb={photo.thumb}
							alt={photo.alt || photo.title || ""}
							albumId={album.id}
						/>
					))}
				</div>
			) : (
				<div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
					<Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
					<p class="text-lg">{i18n(I18nKey.albumsEmpty)}</p>
				</div>
			)}
		</div>
	</div>
</MainGridLayout>

<script>
	// 相册瀑布流：按顺序把每张放进当前最矮的列。
	// 纯 CSS 做不到「紧凑 + 从左到右」——grid 会有竖向空洞，多列是竖着填的。
	function layoutGallery() {
		const grid = document.querySelector(".gallery-masonry");
		if (!grid) return;
		const cards = Array.from(grid.children).filter((el) =>
			el.classList.contains("gallery-photo-card"),
		);
		if (cards.length === 0) return;

		const gap = 12;
		const minWidth = 200;
		const width = grid.clientWidth;
		const cols = Math.max(1, Math.min(4, Math.floor((width + gap) / (minWidth + gap))));
		const colWidth = (width - gap * (cols - 1)) / cols;
		const heights = new Array(cols).fill(0);

		grid.classList.add("is-masonry");
		for (const card of cards) {
			const img = card.querySelector("img");
			const ratio = img && img.naturalWidth > 0 ? img.naturalHeight / img.naturalWidth : 0.72;
			const column = heights.indexOf(Math.min(...heights));
			card.style.left = `${column * (colWidth + gap)}px`;
			card.style.top = `${heights[column]}px`;
			card.style.width = `${colWidth}px`;
			heights[column] += colWidth * ratio + gap;
		}
		grid.style.height = `${Math.max(...heights)}px`;
	}

	function whenImagesReady() {
		const grid = document.querySelector(".gallery-masonry");
		if (!grid) return Promise.resolve();
		const images = Array.from(grid.querySelectorAll("img"));
		return Promise.all(
			images.map((img) =>
				img.complete && img.naturalWidth > 0
					? Promise.resolve()
					: new Promise((resolve) => {
							img.addEventListener("load", () => resolve(), { once: true });
							img.addEventListener("error", () => resolve(), { once: true });
						}),
			),
		);
	}

	const start = () => {
		whenImagesReady().then(() => requestAnimationFrame(layoutGallery));
	};

	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
	else start();

	let resizeTimer = 0;
	window.addEventListener("resize", () => {
		clearTimeout(resizeTimer);
		const grid = document.querySelector(".gallery-masonry");
		grid?.classList.remove("is-masonry");
		resizeTimer = window.setTimeout(start, 250);
	});
</script>
