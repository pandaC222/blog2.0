# 复制为 server/.env 后按实际改。JWT_SECRET 一定要换成长随机串。
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-password

# astro.config 的 site，决定 sitemap / RSS / OG 图里的绝对地址
SITE_URL=https://__DOMAIN__

# 后台保存后自动重建前台。留空则禁用自动重建（改完内容要手动跑 rebuild.sh）
REBUILD_CMD=/opt/blog/deploy/rebuild.sh
